<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="NBT_Studio.Control.NbtTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:NBT_Studio.Model"
    xmlns:converter="using:NBT_Studio.Control.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:NBT_Studio.Library.NBT_Parser.Enum"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 节点字体 -->
        <Style x:Key="TreeNodeFont" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="MiSans VF" />
            <Setter Property="FontWeight" Value="SemiLight" />
        </Style>
        <!-- 节点主文本 -->
        <Style x:Key="TreeNodeText" TargetType="TextBlock" BasedOn="{StaticResource TreeNodeFont}">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <!-- 节点副文本 -->
        <Style x:Key="TreeNodeSubText" TargetType="TextBlock" BasedOn="{StaticResource TreeNodeText}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-3,0,0" />
            <Setter Property="Opacity" Value=".5" />
        </Style>
        <!-- 转换器 -->
        <converter:StringTruncateConverter x:Key="StringTruncateConverter" />

        <DataTemplate x:DataType="model:NbtNode" x:Key="TreeNodeTemplate">
            <TreeViewItem ItemsSource="{Binding Children}"
                          IsExpanded="False"
                          DoubleTapped="TreeViewItem_DoubleClicked"
                          GlyphSize="10"
                          Visibility="{Binding Visibility}"
                          CanDrag="False" AllowDrop="False">
                <!-- 右键菜单 -->
                <TreeViewItem.ContextFlyout>
                    <MenuFlyout>
                        <!-- 插入节点 -->
                        <MenuFlyoutSubItem Text="插入节点">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE710;" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutSubItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="A" />
                            </MenuFlyoutSubItem.KeyboardAccelerators>
                            <MenuFlyoutItem Text="字节" Command="{Binding CreateChildCommand}"
                                            CommandParameter="{x:Bind enum:NbtTagEnum.Byte}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="B" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="短整型" Command="{Binding CreateChildCommand}"
                                            CommandParameter="{x:Bind enum:NbtTagEnum.Short}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="S" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="整型" Command="{Binding CreateChildCommand}"
                                            CommandParameter="{x:Bind enum:NbtTagEnum.Int}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="I" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="长整型" Command="{Binding CreateChildCommand}"
                                            CommandParameter="{x:Bind enum:NbtTagEnum.Long}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="L" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="单精度浮点" Command="{Binding CreateChildCommand}"
                                            CommandParameter="{x:Bind enum:NbtTagEnum.Float}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="双精度浮点" Command="{Binding CreateChildCommand}"
                                            CommandParameter="{x:Bind enum:NbtTagEnum.Double}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="D" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="字符串" Command="{Binding CreateChildCommand}"
                                            CommandParameter="{x:Bind enum:NbtTagEnum.Short}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="S" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="字节数组" Command="{Binding CreateChildCommand}"
                                            CommandParameter="{x:Bind enum:NbtTagEnum.ByteArray}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="B" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="整型数组" Command="{Binding CreateChildCommand}"
                                            CommandParameter="{x:Bind enum:NbtTagEnum.IntArray}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="I" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="长整型数组" Command="{Binding CreateChildCommand}"
                                            CommandParameter="{x:Bind enum:NbtTagEnum.LongArray}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="L" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="字典" Command="{Binding CreateChildCommand}"
                                            CommandParameter="{x:Bind enum:NbtTagEnum.Dictionary}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="D" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="列表" Command="{Binding CreateChildCommand}"
                                            CommandParameter="{x:Bind enum:NbtTagEnum.List}">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="L" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <!-- 重命名 -->
                        <MenuFlyoutItem Text="重命名" Command="{Binding RenameCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8AC;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="M" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <!-- 删除 -->
                        <MenuFlyoutItem Text="删除" Command="{Binding DeleteCommand}"
                                        KeyboardAcceleratorTextOverride="Delete">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" Foreground="#ff7f8d" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Delete" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </TreeViewItem.ContextFlyout>
                <!-- 节点 -->
                <TreeViewItem.Content>
                    <StackPanel Margin="-5,0,0,0" Orientation="Horizontal" Spacing="3">
                        <!-- 图标 -->
                        <Image Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,3,0">
                            <Image.Source>
                                <SvgImageSource UriSource="{Binding Icon}" />
                            </Image.Source>
                        </Image>
                        <!-- 名称 -->
                        <TextBlock Style="{StaticResource TreeNodeText}"
                                   Text="{Binding Name}" />
                        <!-- 子项数量 -->
                        <TextBlock Style="{StaticResource TreeNodeSubText}"
                                   Visibility="{Binding ChildrenCountVisibility}"
                                   Text="{Binding DisplayChildrenCount}" />
                        <!-- 等号 -->
                        <TextBlock Style="{StaticResource TreeNodeSubText}"
                                   Visibility="{Binding EqualMarkVisibility}"
                                   Text="=" />
                        <!-- 值 -->
                        <TextBlock Style="{StaticResource TreeNodeText}"
                                   Text="{Binding Value , Converter={StaticResource StringTruncateConverter}}" />
                    </StackPanel>
                </TreeViewItem.Content>
            </TreeViewItem>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <TreeView
            ItemsSource="{x:Bind Nodes, Mode=TwoWay}"
            ItemTemplate="{StaticResource TreeNodeTemplate}"
            SelectionMode="Single"
            CanDrag="False" CanDragItems="False" AllowDrop="False"
            SelectionChanged="SendSelectedNodeChangedMessage" />
    </Grid>
</UserControl>