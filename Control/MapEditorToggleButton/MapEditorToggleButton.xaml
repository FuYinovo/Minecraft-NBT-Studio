<?xml version="1.0" encoding="utf-8"?>

<mapEditorToggleButton:MapEditorToggleButtonBase
    x:Class="NBT_Studio.Control.MapEditorToggleButton.MapEditorToggleButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iter="using:Microsoft.Xaml.Interactivity"
    xmlns:behavior="using:NBT_Studio.Xaml.Behavior"
    xmlns:mapEditorToggleButton="using:NBT_Studio.Control.MapEditorToggleButton"
    mc:Ignorable="d">

    <mapEditorToggleButton:MapEditorToggleButtonBase.Resources>
        <Style x:Key="ToolsLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </mapEditorToggleButton:MapEditorToggleButtonBase.Resources>

    <Grid>
        <StackPanel Spacing="4">
            <ToggleButton
                Height="48"
                Background="Transparent">
                <FontIcon Glyph="{x:Bind FontIcon}" FontSize="18" />
                <iter:Interaction.Behaviors>
                    <behavior:MutuallyToggleButtonsBehavior GroupName="{x:Bind GroupName}" Value="{x:Bind MemberName}" />
                </iter:Interaction.Behaviors>
            </ToggleButton>
            <TextBlock Style="{StaticResource ToolsLabel}" Text="{x:Bind Title}" />
        </StackPanel>
    </Grid>
</mapEditorToggleButton:MapEditorToggleButtonBase>