<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="NBT_Studio.Control.Content.NbtFileInfoContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Spacing="16">
            <TextBox Header="文件路径" Text="{x:Bind FilePath}" IsReadOnly="True"></TextBox>
            <TextBox Header="文件长度" Text="{x:Bind FileLength}" IsReadOnly="True"></TextBox>
            <ComboBox Header="文件端序" SelectedIndex="{x:Bind IsBigEndian}">
                <ComboBoxItem x:Name="ItemLittleEndian" Content="小端序"></ComboBoxItem>
                <ComboBoxItem x:Name="ItemBiggerEndian" Content="大端序"></ComboBoxItem>
            </ComboBox>
            <ComboBox Header="游戏版本" SelectedIndex="{x:Bind GameEdition}" IsTabStop="False">
                <ComboBoxItem x:Name="ItemJava" Content="Java 版"></ComboBoxItem>
                <ComboBoxItem x:Name="ItemBedrock" Content="基岩版"></ComboBoxItem>
            </ComboBox>
        </StackPanel>
    </Grid>
</UserControl>