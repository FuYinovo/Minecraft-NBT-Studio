<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="NBT_Studio.Control.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:enum="using:NBT_Studio.Enum"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">


    <Grid>
        <StackPanel Spacing="4" Width="360" DataContext="{x:Bind _viewModel}">
            <community:SettingsExpander Header="界面" HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                <community:SettingsExpander.Items>
                    <community:SettingsCard Header="主题"
                                            Description="设置深浅色模式"
                                            Padding="20,20,160,20"
                                            Width="500">
                        <ComboBox SelectedValue="{Binding Theme}" SelectedValuePath="Tag">
                            <ComboBoxItem Tag="{x:Bind enum:Theme.Default}" Content="系统主题"></ComboBoxItem>
                            <ComboBoxItem Tag="{x:Bind enum:Theme.Dark}" Content="深色"></ComboBoxItem>
                            <ComboBoxItem Tag="{x:Bind enum:Theme.Light}" Content="浅色"></ComboBoxItem>
                        </ComboBox>
                    </community:SettingsCard>
                </community:SettingsExpander.Items>
            </community:SettingsExpander>

            <community:SettingsExpander Header="普通" HeaderIcon="{ui:FontIcon Glyph=&#xE713;}">

                <community:SettingsExpander.Items>
                    <community:SettingsCard Header="排序"
                                            Description="节点的排序方式"
                                            Padding="20,20,160,20"
                                            Width="500">
                        <ComboBox SelectedValue="{Binding SortType}" SelectedValuePath="Tag">
                            <ComboBoxItem Tag="{x:Bind enum:SortType.Default}" Content="默认"></ComboBoxItem>
                            <ComboBoxItem Tag="{x:Bind enum:SortType.Alphabetical}" Content="首字母排序"></ComboBoxItem>
                            <ComboBoxItem Tag="{x:Bind enum:SortType.ByType}" Content="类型排序"></ComboBoxItem>
                        </ComboBox>
                    </community:SettingsCard>
                </community:SettingsExpander.Items>
            </community:SettingsExpander>


        </StackPanel>
    </Grid>
</UserControl>