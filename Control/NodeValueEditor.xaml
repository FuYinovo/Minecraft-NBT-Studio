<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="NBT_Studio.Control.NodeValueEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:enum="using:NBT_Studio.Library.NBT_Parser.Enum"
    mc:Ignorable="d">

    <Grid DataContext="{x:Bind _viewModel}">
        <Border Visibility="{Binding UnselectedScreenVisibility}">
            <Border>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="选择节点以查看详情"
                           FontSize="32"
                           FontWeight="Black"
                           Opacity=".6" />
            </Border>
        </Border>

        <community:TabbedCommandBar SizeChanged="CommandBarSizeChanged" >
            <community:TabbedCommandBar.MenuItems>
                <community:TabbedCommandBarItem Header="数据编辑器" IsDynamicOverflowEnabled="False">
                    <AppBarElementContainer Visibility="{Binding SelectedScreenVisibility}">
                        <Grid x:Name="ControlGrid" Padding="-20, 20, 20, 20" ColumnSpacing="24">

                            <StackPanel Spacing="6">
                                <TextBox
                                    Header="名称"
                                    Text="{Binding Name}">
                                </TextBox>
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <StackPanel Spacing="6">
                                            <ComboBox Header="类型" Width="130" SelectedValue="{Binding Type}"
                                                      SelectedValuePath="Tag">
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.Byte}">字节</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.Short}">短整型</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.Long}">长整型</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.Float}">单精度浮点</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.Double}">双精度浮点</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.String}">字符串</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.ByteArray}">字节数组</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.IntArray}">整型数组</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.LongArray}">长整型数组</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.List}">列表</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.Dictionary}">字典</ComboBoxItem>
                                            </ComboBox>
                                            <ComboBox Header="子项类型" Width="130" SelectedValue="{Binding ChildrenType}"
                                                      SelectedValuePath="Tag" IsEnabled="{Binding IsChildrenTypeEnabled}">
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.Byte}">字节</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.Short}">短整型</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.Long}">长整型</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.Float}">单精度浮点</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.Double}">双精度浮点</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.String}">字符串</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.ByteArray}">字节数组</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.IntArray}">整型数组</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.LongArray}">长整型数组</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.List}">列表</ComboBoxItem>
                                                <ComboBoxItem Tag="{x:Bind enum:NbtTagEnum.Dictionary}">字典</ComboBoxItem>
                                            </ComboBox>

                                            <TextBox Header="长度" Width="130"
                                                     IsReadOnly="True"
                                                     BorderThickness="0" Text="{Binding Length}">
                                            </TextBox>
                                            <TextBox Header="最大值" Width="130"
                                                     IsReadOnly="True"
                                                     BorderThickness="0" Text="{Binding MaxValue}"
                                                     IsEnabled="{Binding IsMaxValueEnabled}">
                                            </TextBox>
                                            <TextBox Header="最小值" Width="130"
                                                     IsReadOnly="True"
                                                     Margin="0,0,0,20" 
                                                     BorderThickness="0" Text="{Binding MinValue}"
                                                     IsEnabled="{Binding IsMinValueEnabled}">
                                            </TextBox>


                                            <CheckBox IsChecked="{Binding AllowNegative}" Content="可以为负值"
                                                      IsEnabled="{Binding IsAllowNegativeEnabled}"
                                                      Click="CheckBox_Prohibit">
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding AllowDecimal}" Content="可以为小数"
                                                      IsEnabled="{Binding IsAllowDecimalEnabled}"
                                                      Click="CheckBox_Prohibit">
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding AllowChildren}" Content="可以含子项"
                                                      Click="CheckBox_Prohibit">
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding AllowDelete}" Content="可以被删除"
                                                      Click="CheckBox_Prohibit">
                                            </CheckBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <TextBox Header="数据"
                                                 Text="{Binding Value}"
                                                 TextWrapping="Wrap"
                                                 IsSpellCheckEnabled="False" />
                                    </Grid>
                                </Grid>

                            </StackPanel>


                        </Grid>
                    </AppBarElementContainer>
                </community:TabbedCommandBarItem>
                <community:TabbedCommandBarItem Header="物品编辑器" IsContextual="True">
                    <AppBarElementContainer Visibility="{Binding SelectedScreenVisibility}"></AppBarElementContainer>
                </community:TabbedCommandBarItem>
                <community:TabbedCommandBarItem Header="地图编辑器" IsContextual="True">
                    <AppBarElementContainer Visibility="{Binding SelectedScreenVisibility}"></AppBarElementContainer>
                </community:TabbedCommandBarItem>
            </community:TabbedCommandBar.MenuItems>
        </community:TabbedCommandBar>
    </Grid>
</UserControl>