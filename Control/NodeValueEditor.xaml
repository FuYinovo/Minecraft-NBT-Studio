<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="NBT_Studio.Control.NodeValueEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:NBT_Studio.Model"
    mc:Ignorable="d">


    <Grid DataContext="{x:Bind _viewModel}" x:Name="ControlGrid" Padding="-20, 20, 20, 20" ColumnSpacing="24">

        <StackPanel Spacing="6">
            <TextBox
                Header="名称"
                Text="{Binding Name}" />
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <StackPanel Spacing="6">
                        <TextBox Header="类型" Width="130"
                                 IsReadOnly="True"
                                 BorderThickness="0" Text="{Binding Type}" />
                        <TextBox Header="子项类型" Width="130"
                                 IsReadOnly="True"
                                 IsEnabled="{Binding IsChildrenTypeEnabled}"
                                 BorderThickness="0" Text="{Binding ChildrenType}" />
                        <TextBox Header="长度" Width="130"
                                 IsReadOnly="True"
                                 BorderThickness="0" Text="{Binding Length}" />
                        <TextBox Header="最大值" Width="130"
                                 IsReadOnly="True"
                                 BorderThickness="0" Text="{Binding MaxValue}"
                                 IsEnabled="{Binding IsMaxValueEnabled}" />
                        <TextBox Header="最小值" Width="130"
                                 IsReadOnly="True"
                                 Margin="0,0,0,20"
                                 BorderThickness="0" Text="{Binding MinValue}"
                                 IsEnabled="{Binding IsMinValueEnabled}" />

                        <CheckBox IsChecked="{Binding AllowNegative}" Content="可以为负值"
                                  IsEnabled="{Binding IsAllowNegativeEnabled}"
                                  Click="CheckBox_Prohibit" />
                        <CheckBox IsChecked="{Binding AllowDecimal}" Content="可以为小数"
                                  IsEnabled="{Binding IsAllowDecimalEnabled}"
                                  Click="CheckBox_Prohibit" />
                        <CheckBox IsChecked="{Binding AllowChildren}" Content="可以含子项"
                                  Click="CheckBox_Prohibit" />
                        <CheckBox IsChecked="{Binding AllowDelete}" Content="可以被删除"
                                  Click="CheckBox_Prohibit" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1">
                    <TextBox Header="数据"
                             Text="{Binding Value}"
                             TextWrapping="Wrap"
                             IsSpellCheckEnabled="False" />
                </Grid>
            </Grid>

        </StackPanel>


    </Grid>

</UserControl>