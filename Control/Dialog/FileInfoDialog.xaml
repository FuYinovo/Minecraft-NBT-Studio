<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="NBT_Studio.Control.Dialog.FileInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Spacing="16">
            <TextBox Header="文件路径" Text="{x:Bind FilePath}" IsReadOnly="True" />
            <TextBox Header="文件长度" Text="{x:Bind FileLength}" IsReadOnly="True" />

            <TextBox Header="字节顺序" Text="{x:Bind Endianness}" IsReadOnly="True" />
            <TextBox Header="游戏版本" Text="{x:Bind MinecraftEdition}" IsReadOnly="True" />

            <TextBox Header="压缩类型" Text="{x:Bind CompressType}" IsReadOnly="True"
                     IsEnabled="{x:Bind IsCompressed}" />
        </StackPanel>
    </Grid>
</UserControl>