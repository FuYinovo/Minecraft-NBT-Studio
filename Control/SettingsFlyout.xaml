<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="NBT_Studio.Control.SettingsFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:NBT_Studio.Enum.Settings"
    mc:Ignorable="d">


    <Grid>
        <StackPanel Spacing="4" Width="360" DataContext="{x:Bind _flyoutViewModel}">
            <community:SettingsExpander Header="界面" HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                <community:SettingsExpander.Items>
                    <community:SettingsCard Header="主题"
                                            Description="设置深浅色模式"
                                            Padding="20,20,160,20"
                                            Width="500">
                        <ComboBox x:Name="CombTheme" SelectedValue="{Binding Theme, Mode=TwoWay}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Tag="{x:Bind settings:Theme.Default}" Content="系统" />
                            <ComboBoxItem Tag="{x:Bind settings:Theme.Dark}" Content="深色" />
                            <ComboBoxItem Tag="{x:Bind settings:Theme.Light}" Content="浅色" />
                        </ComboBox>
                    </community:SettingsCard>
                </community:SettingsExpander.Items>
            </community:SettingsExpander>

            <community:SettingsExpander Header="普通" HeaderIcon="{ui:FontIcon Glyph=&#xE713;}">

                <community:SettingsExpander.Items>
                    <community:SettingsCard Header="排序"
                                            Description="节点的排序方式"
                                            Padding="20,20,160,20"
                                            Width="500">
                        <ComboBox x:Name="CombSort" SelectedValue="{Binding Sort, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Tag="{x:Bind settings:Sort.Default}" Content="默认" />
                            <ComboBoxItem Tag="{x:Bind settings:Sort.Alphabetical}" Content="首字母" />
                            <ComboBoxItem Tag="{x:Bind settings:Sort.ByType}" Content="类型" />
                        </ComboBox>
                    </community:SettingsCard>
                </community:SettingsExpander.Items>
            </community:SettingsExpander>


        </StackPanel>
    </Grid>
</UserControl>