<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="NBT_Studio.View.TreeViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="using:NBT_Studio.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:labs="using:CommunityToolkit.Labs.WinUI"
    mc:Ignorable="d">

    <Grid DataContext="{x:Bind _viewModel}" Padding="10,5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧节点区 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 操作区 -->
            <Grid Grid.Row="0" Width="900" MinWidth="630" x:Name="TreeViewGrid">
                <community:TabbedCommandBar>
                    <!-- 头部 -->
                    <community:TabbedCommandBar.AutoSuggestBox>
                        <AutoSuggestBox x:Name="NodeSearch" QueryIcon="Find" PlaceholderText="搜索节点" />
                    </community:TabbedCommandBar.AutoSuggestBox>
                    <community:TabbedCommandBar.PaneFooter>
                        <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                            <AppBarButton Label="设置" Icon="Setting" />
                            <AppBarButton Label="关于" Icon="Help" />
                        </CommandBar>
                    </community:TabbedCommandBar.PaneFooter>
                    <!-- 子页面 -->
                    <community:TabbedCommandBar.MenuItems>
                        <!-- 文件操作页 -->
                        <community:TabbedCommandBarItem Header="文件操作">
                            <AppBarButton Label="新建"
                                          IsCompact="True">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xECC8;" />
                                </AppBarButton.Icon>
                                <AppBarButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Java 版"
                                                        Command="{Binding CreateFileCommand}"
                                                        CommandParameter="Java" />
                                        <MenuFlyoutItem Text="基岩版"
                                                        Command="{Binding CreateFileCommand}"
                                                        CommandParameter="Bedrock" />
                                    </MenuFlyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <AppBarButton Label="加载"
                                          IsCompact="True">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </AppBarButton.Icon>
                                <AppBarButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Java 版"
                                                        Command="{Binding LoadFileCommand}"
                                                        CommandParameter="Java" />
                                        <MenuFlyoutItem Text="基岩版"
                                                        Command="{Binding LoadFileCommand}"
                                                        CommandParameter="Bedrock" />
                                    </MenuFlyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <AppBarButton Label="保存"
                                          Command="{Binding ApplyFileCommand}"
                                          IsEnabled="{Binding IsApplyEnabled}">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="另存为"
                                          Command="{Binding SaveFileCommand}"
                                          IsEnabled="{Binding IsSaveEnabled}">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE792;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton Label="信息" HorizontalAlignment="Right"
                                          Command="{Binding ShowFileInfoCommand}"
                                          IsEnabled="{Binding IsInfoEnabled}">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE946;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </community:TabbedCommandBarItem>
                        <!-- 添加节点页 -->
                        <community:TabbedCommandBarItem Header="添加节点">
                            <!-- 基础数据类型 -->
                            <AppBarElementContainer>
                                <StackPanel Orientation="Horizontal">
                                    <control:NbtInsertButton Label="字节"
                                                             IconUri="ms-appx:///Assets/NodeIcon/Data_node_byte.svg" />
                                    <control:NbtInsertButton Label="短整数"
                                                             IconUri="ms-appx:///Assets/NodeIcon/Data_node_short.svg" />
                                    <control:NbtInsertButton Label="整数"
                                                             IconUri="ms-appx:///Assets/NodeIcon/Data_node_int.svg" />
                                    <control:NbtInsertButton Label="长整数"
                                                             IconUri="ms-appx:///Assets/NodeIcon/Data_node_long.svg" />
                                    <control:NbtInsertButton Label="单精浮点"
                                                             IconUri="ms-appx:///Assets/NodeIcon/Data_node_float.svg" />
                                    <control:NbtInsertButton Label="双精浮点"
                                                             IconUri="ms-appx:///Assets/NodeIcon/Data_node_double.svg" />
                                    <control:NbtInsertButton Label="字符串"
                                                             IconUri="ms-appx:///Assets/NodeIcon/Data_node_string.svg" />
                                </StackPanel>
                            </AppBarElementContainer>
                            <AppBarSeparator />
                            <!-- 数组类型 -->
                            <AppBarElementContainer>
                                <StackPanel Orientation="Horizontal">
                                    <control:NbtInsertButton Label="字节组"
                                                             IconUri="ms-appx:///Assets/NodeIcon/Data_node_byte-array.svg" />
                                    <control:NbtInsertButton Label="整数组"
                                                             IconUri="ms-appx:///Assets/NodeIcon/Data_node_int-array.svg" />
                                    <control:NbtInsertButton Label="长整数组"
                                                             IconUri="ms-appx:///Assets/NodeIcon/Data_node_long-array.svg" />
                                </StackPanel>
                            </AppBarElementContainer>
                            <AppBarSeparator />
                            <!-- 复合类型 -->
                            <AppBarElementContainer>
                                <StackPanel Orientation="Horizontal">
                                    <control:NbtInsertButton Label="字典"
                                                             IconUri="ms-appx:///Assets/NodeIcon/Data_node_dictionary.svg" />
                                    <control:NbtInsertButton Label="列表"
                                                             IconUri="ms-appx:///Assets/NodeIcon/Data_node_list.svg" />
                                </StackPanel>
                            </AppBarElementContainer>
                        </community:TabbedCommandBarItem>
                    </community:TabbedCommandBar.MenuItems>
                </community:TabbedCommandBar>
            </Grid>
            <!-- 节点区 -->
            <Grid Grid.Row="1" Margin="0,10,0,0" RowSpacing="30">
                <ScrollView>
                    <StackPanel Spacing="10">
                        <!-- 节点筛选 -->
                        <labs:TokenView HorizontalAlignment="Center" SelectedIndex="0">
                            <labs:TokenItem Content="全部" />
                            <labs:TokenItem Content="字节" />
                            <labs:TokenItem Content="短整数" />
                            <labs:TokenItem Content="整数" />
                            <labs:TokenItem Content="长整数" />
                            <labs:TokenItem Content="单精浮点" />
                            <labs:TokenItem Content="双精浮点" />
                            <labs:TokenItem Content="字符串" />
                        </labs:TokenView>
                        <!-- 节点树 -->
                        <control:NbtTreeView Nodes="{Binding Nodes}" />
                    </StackPanel>

                </ScrollView>
            </Grid>
        </Grid>

        <community:ContentSizer Grid.Column="1" TargetControl="{x:Bind TreeViewGrid}" />

        <!-- 右侧详情区 -->
        <Grid Grid.Column="2">
            <Border Visibility="Collapsed"
                    MinWidth="400">
                <Border Background="{ThemeResource AccentAAFillColorDefaultBrush}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               Text="选择节点查看详情"
                               FontSize="32"
                               FontWeight="Black"
                               Opacity=".6" />
                </Border>
            </Border>

            <community:TabbedCommandBar Visibility="Visible">

                <community:TabbedCommandBar.MenuItems>
                    <community:TabbedCommandBarItem Header="数据编辑器">
                        <AppBarElementContainer />
                    </community:TabbedCommandBarItem>
                    <community:TabbedCommandBarItem Header="物品编辑器" IsContextual="True">
                        <AppBarElementContainer />
                    </community:TabbedCommandBarItem>
                    <community:TabbedCommandBarItem Header="地图编辑器" IsContextual="True">
                        <AppBarElementContainer />
                    </community:TabbedCommandBarItem>
                </community:TabbedCommandBar.MenuItems>
            </community:TabbedCommandBar>
        </Grid>
    </Grid>
</Page>