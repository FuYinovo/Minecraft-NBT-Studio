<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="NBT_Studio.View.MapEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:graphic="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:enum="using:NBT_Studio.Enum"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:converter="using:NBT_Studio.Xaml.Converter"
    xmlns:view="using:NBT_Studio.View"
    xmlns:mapEditorButton="using:NBT_Studio.Xaml.Control.MapEditorButton"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 地图背景色 -->
        <Style x:Key="MapBackground" TargetType="Border">
            <Setter Property="Background" Value="#40d2b48c" />
        </Style>
        <!-- 工具栏标签 -->
        <Style x:Key="ToolsLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- 转换器 -->
        <converter:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </UserControl.Resources>

    <Grid DataContext="{x:Bind ViewModel}" x:Name="ControlGrid" Padding="-32,20,20,5" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,0" CornerRadius="6">
            <StackPanel Spacing="12"
                        Padding="12,8,12,0"
                        Height="82"
                        Orientation="Horizontal"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorSecondary}">
                <!-- 选择 -->
                <mapEditorButton:ToggleButtonMutually
                    FontIcon="&#xEF20;"
                    GroupName="MapEditorTools"
                    MemberTag="{x:Bind enum:MapEditorTool.Select}"
                    Title="选择" />
                <AppBarSeparator Margin="0,-5,0,0" />

                <!-- 工具 -->
                <StackPanel Spacing="2">
                    <StackPanel Spacing="1">
                        <!-- 第一行 -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <!-- 橡皮 -->
                            <mapEditorButton:ToggleButtonCompact
                                FontIcon="&#xE75C;"
                                GroupName="MapEditorTools"
                                MemberTag="{x:Bind enum:MapEditorTool.Eraser}" />
                            <!-- 移动画布 -->
                            <mapEditorButton:ToggleButtonCompact
                                FontIcon="&#xE7C2;"
                                GroupName="MapEditorTools"
                                MemberTag="{x:Bind enum:MapEditorTool.Move}" />
                        </StackPanel>
                        <!-- 第二行 -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <!-- 吸色器 -->
                            <mapEditorButton:ToggleButtonCompact
                                FontIcon="&#xEF3C;"
                                GroupName="MapEditorTools"
                                MemberTag="{x:Bind enum:MapEditorTool.ColorPicker}" />
                            <!-- 缩放 -->
                            <mapEditorButton:ToggleButtonCompact
                                FontIcon="&#xE8A3;"
                                GroupName="MapEditorTools"
                                MemberTag="{x:Bind enum:MapEditorTool.Zoom}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource ToolsLabel}" Text="工具" />
                </StackPanel>
                <AppBarSeparator Margin="0,-5,0,0" />

                <!-- 笔刷 -->
                <mapEditorButton:ToggleButtonMutually
                    FontIcon="&#xE771;"
                    GroupName="MapEditorTools"
                    MemberTag="{x:Bind enum:MapEditorTool.Brush}"
                    Title="笔刷" />
                <AppBarSeparator Margin="0,-5,0,0" />

                <!-- 颜色 -->
                <StackPanel Spacing="2">
                    <DropDownButton Width="54" Height="50" Padding="6,8,5,8">
                        <!-- 颜色预览 -->
                        <Border
                            Background="{Binding ClosestMapColor,
                                Mode=OneWay,
                                Converter={StaticResource ColorToBrushConverter}}"
                            Width="20"
                            Height="30"
                            CornerRadius="4" />
                        <!-- 颜色选择器 -->
                        <DropDownButton.Flyout>
                            <Flyout>
                                <controls:ColorPicker
                                    ColorSpectrumShape="Box"
                                    IsAlphaSliderVisible="False"
                                    IsColorChannelTextInputVisible="True"
                                    IsColorPaletteVisible="True"
                                    ShowAccentColors="False"
                                    Color="{Binding BrushColor, Mode=TwoWay}" />
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock Style="{StaticResource ToolsLabel}" Text="颜色" />
                </StackPanel>
                <AppBarSeparator Margin="0,-5,0,0" />

                <!--导入-->
                <mapEditorButton:ButtonSeparate
                    FontIcon="&#xE78B;"
                    Title="导入"
                    ButtonCommand="{Binding ImportImageCommand}" />
            </StackPanel>
        </Grid>

        <!-- 地图预览 -->
        <Grid Grid.Row="1">
            <Border
                Margin="0,0,0,58"
                x:Name="MapBorder"
                Style="{StaticResource MapBackground}"
                CornerRadius="12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <graphic:CanvasControl
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="1024"
                    Height="1024"
                    x:Name="MapCanvas"
                    AllowDrop="True"
                    Draw="DrawMap" />
            </Border>
            <!-- 保存按钮 -->
            <Button
                x:Name="SaveButton"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{ThemeResource AccentButtonStyle}"
                IsEnabled="False"
                Content="保存修改"
                Click="SaveButton_OnClick"
                Command="{Binding SaveValueChangesCommand}" />

            <!-- 笔刷半径 -->
            <Border HorizontalAlignment="Left"
                    Padding="0,10"
                    Margin="10,0,0,0"
                    CornerRadius="8"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    Height="250">
                <Slider
                    Value="{x:Bind BrushRadius, Mode=TwoWay}"
                    Header="{ui:FontIcon FontSize=16, Glyph=&#xEDA8;}"
                    StepFrequency="1"
                    Maximum="{x:Bind view:MapEditor.MaxBrushRadius}"
                    Minimum="{x:Bind view:MapEditor.MinBrushRadius}"
                    VerticalAlignment="Stretch"
                    Orientation="Vertical" />
            </Border>

            <!-- 画布缩放 -->
            <StackPanel Orientation="Horizontal" Padding="5" HorizontalAlignment="Left" Spacing="6"
                        VerticalAlignment="Bottom" Background="{ThemeResource CardBackgroundFillColorSecondary}"
                        CornerRadius="8">
                <Button Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Content="{ui:FontIcon Glyph=&#xE71F;}" />
                <Slider
                    Value="{x:Bind MapScale, Mode=TwoWay}"
                    Width="120"
                    StepFrequency=".1"
                    Maximum="{x:Bind view:MapEditor.MaxZoomFactor}"
                    Minimum="{x:Bind view:MapEditor.MinZoomFactor}" />

                <Button Width="32"
                        Height="32"
                        Padding="0"
                        BorderBrush="Transparent"
                        Background="Transparent"
                        Content="{ui:FontIcon Glyph=&#xE8A3;}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>