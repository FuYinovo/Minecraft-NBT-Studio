<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="NBT_Studio.View.MapEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:graphic="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:mapEditorToggleButton="using:NBT_Studio.Control.MapEditorToggleButton"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 地图背景色 -->
        <Style x:Key="MapBackground" TargetType="Border">
            <Setter Property="Background" Value="#40d2b48c" />
        </Style>
        <!-- 工具栏标签 -->
        <Style x:Key="ToolsLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid DataContext="{x:Bind _viewModel}" x:Name="ControlGrid" Padding="-32,20,20,20" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,0" CornerRadius="6">
            <StackPanel Spacing="16"
                        Padding="12,8,12,0"
                        Height="82"
                        Orientation="Horizontal"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorSecondary}">
                <!-- 选择 -->
                <mapEditorToggleButton:MapEditorToggleButton
                    FontIcon="&#xEF20;"
                    GroupName="MapEditorTools"
                    MemberName="All"
                    Title="选择" />
                <AppBarSeparator Margin="0,-5,0,0" />

                <!-- 工具 -->
                <StackPanel Spacing="2">
                    <StackPanel Spacing="1">
                        <!-- 第一行 -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <!-- 橡皮 -->
                            <mapEditorToggleButton:MapEditorToggleButtonCompact
                                FontIcon="&#xE75C;"
                                GroupName="MapEditorTools"
                                MemberName="Eraser" />
                            <!-- 文本 -->
                            <mapEditorToggleButton:MapEditorToggleButtonCompact
                                FontIcon="&#xE8D2;"
                                GroupName="MapEditorTools"
                                MemberName="Text" />
                        </StackPanel>
                        <!-- 第二行 -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <!-- 吸色器 -->
                            <mapEditorToggleButton:MapEditorToggleButtonCompact
                                FontIcon="&#xEF3C;"
                                GroupName="MapEditorTools"
                                MemberName="ColorPicker" />
                            <!-- 缩放 -->
                            <mapEditorToggleButton:MapEditorToggleButtonCompact
                                FontIcon="&#xE8A3;"
                                GroupName="MapEditorTools"
                                MemberName="Zoom" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource ToolsLabel}" Text="工具" />
                </StackPanel>
                <AppBarSeparator Margin="0,-5,0,0" />

                <!-- 笔刷 -->
                <mapEditorToggleButton:MapEditorToggleSplitButton
                    FontIcon="&#xE771;"
                    GroupName="MapEditorTools"
                    MemberName="Brush"
                    Title="笔刷">
                    <mapEditorToggleButton:MapEditorToggleSplitButton.Menu>
                        <x:String>{>}像素</x:String>
                        <x:String>画笔</x:String>
                    </mapEditorToggleButton:MapEditorToggleSplitButton.Menu>
                </mapEditorToggleButton:MapEditorToggleSplitButton>
                <AppBarSeparator Margin="0,-5,0,0"></AppBarSeparator>


            </StackPanel>
        </Grid>

        <!-- 地图预览 -->
        <Grid Grid.Row="1">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource MapBackground}"
                    CornerRadius="12"
                    Width="{x:Bind BorderSize, Mode=OneWay}"
                    Height="{x:Bind BorderSize, Mode=OneWay}">
                <graphic:CanvasControl
                    x:Name="MapCanvas"
                    Width="{x:Bind MapSize, Mode=OneWay}"
                    Height="{x:Bind MapSize, Mode=OneWay}"
                    AllowDrop="True"
                    Draw="DrawMap" />
            </Border>
        </Grid>

    </Grid>

</UserControl>