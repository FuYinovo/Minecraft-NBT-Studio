<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="NBT_Studio.View.MapEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:graphic="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:enum="using:NBT_Studio.Enum"
    xmlns:converter="using:NBT_Studio.Xaml.Converter"
    xmlns:mapEditorToggleButton1="using:NBT_Studio.Xaml.Control.MapEditorToggleButton"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 地图背景色 -->
        <Style x:Key="MapBackground" TargetType="Border">
            <Setter Property="Background" Value="#40d2b48c" />
        </Style>
        <!-- 工具栏标签 -->
        <Style x:Key="ToolsLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- 转换器 -->
        <converter:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </UserControl.Resources>

    <Grid DataContext="{x:Bind ViewModel}" x:Name="ControlGrid" Padding="-32,20,20,5" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,0" CornerRadius="6">
            <StackPanel Spacing="16"
                        Padding="12,8,12,0"
                        Height="82"
                        Orientation="Horizontal"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorSecondary}">
                <!-- 选择 -->
                <mapEditorToggleButton1:MapEditorToggleButton
                    FontIcon="&#xEF20;"
                    GroupName="MapEditorTools"
                    MemberTag="{x:Bind enum:MapEditorTool.Select}"
                    Title="选择" />
                <AppBarSeparator Margin="0,-5,0,0" />

                <!-- 工具 -->
                <StackPanel Spacing="2">
                    <StackPanel Spacing="1">
                        <!-- 第一行 -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <!-- 橡皮 -->
                            <mapEditorToggleButton1:MapEditorToggleButtonCompact
                                FontIcon="&#xE75C;"
                                GroupName="MapEditorTools"
                                MemberTag="{x:Bind enum:MapEditorTool.Eraser}" />
                            <!-- 移动画布 -->
                            <mapEditorToggleButton1:MapEditorToggleButtonCompact
                                FontIcon="&#xE7C2;"
                                GroupName="MapEditorTools"
                                MemberTag="{x:Bind enum:MapEditorTool.Move}" />
                        </StackPanel>
                        <!-- 第二行 -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <!-- 吸色器 -->
                            <mapEditorToggleButton1:MapEditorToggleButtonCompact
                                FontIcon="&#xEF3C;"
                                GroupName="MapEditorTools"
                                MemberTag="{x:Bind enum:MapEditorTool.ColorPicker}" />
                            <!-- 缩放 -->
                            <mapEditorToggleButton1:MapEditorToggleButtonCompact
                                FontIcon="&#xE8A3;"
                                GroupName="MapEditorTools"
                                MemberTag="{x:Bind enum:MapEditorTool.Zoom}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource ToolsLabel}" Text="工具" />
                </StackPanel>
                <AppBarSeparator Margin="0,-5,0,0" />

                <!-- 笔刷 -->
                <mapEditorToggleButton1:MapEditorToggleSplitButton
                    FontIcon="&#xE771;"
                    GroupName="MapEditorTools"
                    MemberTag="{x:Bind enum:MapEditorTool.Brush}"
                    Title="笔刷">
                    <mapEditorToggleButton1:MapEditorToggleSplitButton.Menu>
                        <x:String>{>}像素</x:String>
                        <x:String>画笔</x:String>
                    </mapEditorToggleButton1:MapEditorToggleSplitButton.Menu>
                </mapEditorToggleButton1:MapEditorToggleSplitButton>
                <AppBarSeparator Margin="0,-5,0,0" />

                <!-- 颜色 -->
                <StackPanel Spacing="2">
                    <DropDownButton Width="54" Height="50" Padding="6,8,5,8">
                        <!-- 颜色预览 -->
                        <Border
                            Background="{Binding ClosestMapColor,
                                Mode=OneWay,
                                Converter={StaticResource ColorToBrushConverter}}"
                            Width="20"
                            Height="30"
                            CornerRadius="4" />
                        <!-- 颜色选择器 -->
                        <DropDownButton.Flyout>
                            <Flyout>
                                <controls:ColorPicker
                                    ColorSpectrumShape="Box"
                                    IsAlphaSliderVisible="False"
                                    IsColorChannelTextInputVisible="True"
                                    IsColorPaletteVisible="True"
                                    ShowAccentColors="False"
                                    Color="{Binding BrushColor, Mode=TwoWay}" />
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock Style="{StaticResource ToolsLabel}" Text="颜色" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 地图预览 -->
        <Grid Grid.Row="1">
            <Slider
                Value="{x:Bind MapScale, Mode=TwoWay}"
                Margin="0,0,0,58"
                Header="缩放"
                StepFrequency=".1"
                Maximum="80"
                Minimum="1"
                VerticalAlignment="Stretch"
                Orientation="Vertical" />
            <Border
                Margin="50,0,0,58"
                x:Name="MapBorder"
                Style="{StaticResource MapBackground}"
                CornerRadius="12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <graphic:CanvasControl
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="1024"
                    Height="1024"
                    x:Name="MapCanvas"
                    AllowDrop="True"
                    Draw="DrawMap" />
            </Border>
            <!-- 保存按钮 -->
            <Button
                x:Name="SaveButton"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{ThemeResource AccentButtonStyle}"
                IsEnabled="False"
                Content="保存修改"
                Click="SaveButton_OnClick"
                Command="{Binding SaveValueChangesCommand}" />

        </Grid>
    </Grid>
</UserControl>