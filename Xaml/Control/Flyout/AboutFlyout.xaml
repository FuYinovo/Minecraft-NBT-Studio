<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="NBT_Studio.Xaml.Control.Flyout.AboutFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">


    <Grid Padding="32,0">
        <StackPanel>
            <Border>
                <Image Width="64" Height="64" Source="/Assets/PNG/AppLogo.png" />
            </Border>
            <TextBlock HorizontalAlignment="Center"
                       Text="NBT Studio"
                       Margin="0,0,0,10"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="一个 Minecraft NBT 文件编辑器"
                       Style="{StaticResource BaseTextBlockStyle}"
                       HorizontalAlignment="Center"
                       MaxWidth="240"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20" />

            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <HyperlinkButton
                        NavigateUri="https://github.com/FuYinovo/Minecraft-NBT-Studio/">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="32" Height="32" Margin="0,0,0,-6">
                                <Image.Source>
                                    <SvgImageSource UriSource="/Assets/SVG/Github.svg" />
                                </Image.Source>
                            </Image>
                            <TextBlock Text="Github"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       FontSize="16" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <HyperlinkButton
                        NavigateUri="https://space.bilibili.com/418002247">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="32" Height="32" Margin="-6,-4,0,0">
                                <Image.Source>
                                    <SvgImageSource UriSource="/Assets/SVG/Bilibili.svg" />
                                </Image.Source>
                            </Image>
                            <TextBlock Text="浮音ovo"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       FontSize="16" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>