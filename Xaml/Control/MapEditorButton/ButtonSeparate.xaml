<?xml version="1.0" encoding="utf-8"?>

<mapEditorButton:ButtonBase
    x:Class="NBT_Studio.Xaml.Control.MapEditorButton.ButtonSeparate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mapEditorButton="using:NBT_Studio.Xaml.Control.MapEditorButton"
    mc:Ignorable="d">

    <mapEditorButton:ButtonBase.Resources>
        <Style x:Key="ToolsLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </mapEditorButton:ButtonBase.Resources>

    <Grid>
        <StackPanel Spacing="4">
            <Button Height="48" Command="{x:Bind ButtonCommand}">
                <FontIcon Glyph="{x:Bind FontIcon}" FontSize="18" />
            </Button>
            <TextBlock Style="{StaticResource ToolsLabel}" Text="{x:Bind Title}" />
        </StackPanel>
    </Grid>
</mapEditorButton:ButtonBase>