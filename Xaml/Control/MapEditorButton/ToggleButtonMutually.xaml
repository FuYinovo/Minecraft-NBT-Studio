<?xml version="1.0" encoding="utf-8"?>

<mapEditorButton:ButtonBase
    x:Class="NBT_Studio.Xaml.Control.MapEditorButton.ToggleButtonMutually"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iter="using:Microsoft.Xaml.Interactivity"
    xmlns:behavior="using:NBT_Studio.Xaml.Behavior"
    xmlns:mapEditorButton="using:NBT_Studio.Xaml.Control.MapEditorButton"
    mc:Ignorable="d">

    <mapEditorButton:ButtonBase.Resources>
        <Style x:Key="ToolsLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </mapEditorButton:ButtonBase.Resources>

    <Grid>
        <StackPanel Spacing="4">
            <ToggleButton
                Height="48"
                Background="Transparent">
                <FontIcon Glyph="{x:Bind FontIcon}" FontSize="18" />
                <iter:Interaction.Behaviors>
                    <behavior:MutuallyToggleButtonsBehavior
                        GroupName="{x:Bind GroupName}"
                        Tag="{x:Bind MemberTag}"/>
                </iter:Interaction.Behaviors>
            </ToggleButton>
            <TextBlock Style="{StaticResource ToolsLabel}" Text="{x:Bind Title}" />
        </StackPanel>
    </Grid>
</mapEditorButton:ButtonBase>